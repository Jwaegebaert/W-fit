<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- End of a countdown with the screen off; a timer app gets this without asking. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- Shortcut back to the workout on the watch face. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Live heart rate on screen (optional): Wear OS 6 has its own permission, older versions the body sensors. -->
    <uses-feature
        android:name="android.hardware.sensor.heartrate"
        android:required="false"/>
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">
        <uses-library
            android:name="com.google.android.wearable"
            android:required="true"/>
        <!-- Needs the phone app to start a workout. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The phone opens the app when a workout starts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="wfit" android:host="workout"/>
            </intent-filter>
        </activity>
        <!-- "Why does it need this" link of the system's health permission screen. -->
        <activity-alias
            android:name=".PermissionUsage"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <service
            android:name=".link.PhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED"/>
                <data android:scheme="wear" android:host="*" android:pathPrefix="/wfit/session"/>
            </intent-filter>
        </service>
        <receiver
            android:name=".timer.CountdownReceiver"
            android:exported="false"/>
    </application>
</manifest>
